# ============================================================================
# MEDICLIN Enterprise SaaS Environment Configuration Template
# Initial Target Market: Bangladesh (BDT ৳ / Asia/Dhaka)
# ============================================================================

# Platform Configuration
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Supabase Cloud Database & Authentication (Optional for cloud sync; local engine active by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Bangladesh Payment Gateways (MFS & Cards)
# bKash Tokenized Checkout API
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Nagad PGW Merchant API
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_SANDBOX=true

# SSLCommerz Hosted Payment Gateway
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_SANDBOX=true

# Telemedicine & WebRTC Credentials
DAILY_API_KEY=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
